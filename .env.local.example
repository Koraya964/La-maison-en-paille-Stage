# .env.local — NE JAMAIS COMMITTER CE FICHIER SUR GIT !
# Copiez ce fichier sous le nom .env.local et remplissez les valeurs.

# ─── Base de données MySQL ────────────────────────────────────────────────────
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=votre_mot_de_passe_mysql
DB_NAME=la_maison_en_paille

# ─── Authentification JWT ────────────────────────────────────────────────────
# Générez une chaîne aléatoire forte, par exemple avec :
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=remplacez_par_une_chaine_aleatoire_longue_et_secrete

# ─── URL publique du site ─────────────────────────────────────────────────────
NEXT_PUBLIC_URL=http://localhost:3000
# En production : NEXT_PUBLIC_URL=https://www.lamaisonenpaille.com
